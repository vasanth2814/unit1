enum Grade {
    case A, B, C, D, F
}

struct Student {
    var name: String
    var marks: Int

    var grade: Grade {
        switch marks {
        case 90...100: return .A
        case 80..<90: return .B
        case 70..<80: return .C
        case 60..<70: return .D
        default: return .F
        }
    }
}

class School {
    var students: [Student] = []

    func addStudent(_ student: Student) {
        students.append(student)
    }

    func printReport() {
        let sorted = students.sorted {
            $0.marks > $1.marks
        }

        print("Student Report")

        for student in sorted {
            print("\(student.name) - \(student.marks) - \(student.grade)")
        }
    }
}

let school = School()

school.addStudent(Student(name: "Arun", marks: 85))
school.addStudent(Student(name: "Ravi", marks: 95))
school.addStudent(Student(name: "Kumar", marks: 72))
school.addStudent(Student(name: "Mani", marks: 55))

school.printReport()
