class Vehicle {
    func description() {
        print("This is a vehicle")
    }
}

class Car: Vehicle {
    override func description() {
        print("This is a car")
    }
}

class Bike: Vehicle {
    override func description() {
        print("This is a bike")
    }
}

let vehicles: [Vehicle] = [Car(), Bike(), Vehicle()]

for vehicle in vehicles {
    vehicle.description()
}
