struct Student {
    var name: String
    var marks: Int

    init?(name: String, marks: Int) {
        if marks < 0 || marks > 100 {
            return nil
        }

        self.name = name
        self.marks = marks
    }
}

if let s = Student(name: "Arun", marks: 85) {
    print(s.name, s.marks)
} else {
    print("Invalid marks")
}
