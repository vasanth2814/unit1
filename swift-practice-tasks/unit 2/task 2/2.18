let prices: [String: Double] = [
    "Apple": 20.0,
    "Milk": 30.0,
    "Bread": 40.0,
    "Rice": 60.0
]

let cart = ["Apple", "Milk", "Bread"]

var total = 0.0

for item in cart {
    if let price = prices[item] {
        total += price
    }
}

print("Shopping Cart:", cart)
print("Total Bill: ₹\(total)")
