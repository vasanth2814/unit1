class Car {
    var brand: String
    var speed: Int

    init(brand: String, speed: Int) {
        self.brand = brand
        self.speed = speed
    }

    func accelerate() {
        speed += 10
    }

    func brake() {
        speed -= 10
    }
}

let car = Car(brand: "BMW", speed: 50)

car.accelerate()
print(car.speed)

car.brake()
print(car.speed)
