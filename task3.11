struct Student {
    var marks: Int
}

class Person {
    var age: Int

    init(age: Int) {
        self.age = age
    }
}

var s1 = Student(marks: 80)
var s2 = s1
s2.marks = 50

print(s1.marks)
print(s2.marks)

let p1 = Person(age: 20)
let p2 = p1
p2.age = 25

print(p1.age)
print(p2.age)

// Struct: Copy is independent, so s1 remains 80.
// Class: Both variables refer to the same object, so p1 also becomes 25.
